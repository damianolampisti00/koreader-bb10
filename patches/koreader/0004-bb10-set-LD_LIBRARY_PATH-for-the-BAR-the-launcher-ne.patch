Subject: [PATCH 4/7] bb10: set LD_LIBRARY_PATH for the BAR (the launcher needs
 libgcc_s)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 platform/bb10/bar-descriptor.xml.in | 1 +
 1 file changed, 1 insertion(+)

diff --git a/platform/bb10/bar-descriptor.xml.in b/platform/bb10/bar-descriptor.xml.in
index 9fc1e1cfc..83d4d245a 100644
--- a/platform/bb10/bar-descriptor.xml.in
+++ b/platform/bb10/bar-descriptor.xml.in
@@ -19,6 +19,7 @@
     </icon>
     <asset path="icon.png">icon.png</asset>
 @ASSETS@
+    <env var="LD_LIBRARY_PATH" value="app/native/koreader/libs"/>
     <permission system="true">run_native</permission>
     <permission>access_shared</permission>
     <permission>access_internet</permission>
