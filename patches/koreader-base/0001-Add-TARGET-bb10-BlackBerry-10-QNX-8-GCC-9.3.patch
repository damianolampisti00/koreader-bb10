++#else
++			hints.ai_flags = 0;
++#endif
+ 			if ((s = getaddrinfo(h, p, &hints, &res0)) != 0) {
+ 				tls_set_errorx(ctx, TLS_ERROR_UNKNOWN,
+ 				    "%s", gai_strerror(s));
