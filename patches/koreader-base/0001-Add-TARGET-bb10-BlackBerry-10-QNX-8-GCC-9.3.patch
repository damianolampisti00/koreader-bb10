+diff --color -ruN a/crypto/compat/arc4random.h b/crypto/compat/arc4random.h
+--- a/crypto/compat/arc4random.h	2026-10-28 19:32:00.946663537 +0100
++++ b/crypto/compat/arc4random.h	2026-10-28 19:32:14.063673087 +0100
+@@ -21,6 +21,9 @@
+ #elif defined(__NetBSD__)
+ #include "arc4random_netbsd.h"
+ 
++#elif defined(__QNX__)
++#include "arc4random_linux.h"
++
