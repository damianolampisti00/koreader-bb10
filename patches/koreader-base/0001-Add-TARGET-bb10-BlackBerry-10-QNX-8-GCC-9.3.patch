     make -C ${SOURCE_DIR}
diff --git a/toolchain/bb10/compat/strndup.c b/toolchain/bb10/compat/strndup.c
new file mode 100644
index 00000000..58019bdb
--- /dev/null
+++ b/toolchain/bb10/compat/strndup.c
@@ -0,0 +1,15 @@
+/* strndup() for BB10 (QNX 8), whose libc lacks it. */
+#include <stdlib.h>
+#include <string.h>
+
+__attribute__((visibility("hidden")))
+char *strndup(const char *s, size_t n)
+{
+    size_t len = strnlen(s, n);
+    char *d = malloc(len + 1);
+    if (d) {
+        memcpy(d, s, len);
+        d[len] = '\0';
+    }
+    return d;
+}
