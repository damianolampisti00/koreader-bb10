diff --git a/Makefile.defs b/Makefile.defs
index 6240b3be..53121cd8 100644
--- a/Makefile.defs
+++ b/Makefile.defs
@@ -247,6 +247,10 @@ else ifeq ($(TARGET), cervantes)
 		CHOST?=arm-linux-gnueabi
 	endif
 	USE_LJ_WPACLIENT=1
+else ifeq ($(TARGET), bb10)
+	# BlackBerry 10 (QNX 8.0), with BerryCore's GCC 9.3 toolchain.
+	BB10=1
+	CHOST?=arm-blackberry-qnx8eabi
 else ifndef TARGET
 	# if TARGET is not defined we will build an emulator on current machine
 	EMULATE_READER=1
@@ -579,6 +583,18 @@ else ifeq ($(TARGET), cervantes)
 		COMPAT_CFLAGS:=$(UBUNTU_COMPAT_CFLAGS)
 		COMPAT_CXXFLAGS:=$(UBUNTU_COMPAT_CFLAGS)
 	endif
+else ifeq ($(TARGET), bb10)
+	# Krait (Snapdragon S4 Plus), the BB10 ABI is softfp.
+	TARGET_CFLAGS:=$(ARMV7_A9_ARCH)
+	TARGET_CFLAGS+=-mfloat-abi=softfp
+	# NOTE: the toolchain's specs put `-isystem $QNX_INC` first, so QNX_INC must point
+	# to NDK headers stripped of the third-party libraries we build (zlib, png, freetype…).
+	# Add a few headers the NDK lacks (endian.h, byteswap.h, syslog.h).
+	BB10_TC_DIR:=$(abspath $(KOR_BASE)/toolchain/bb10)
+	COMPAT_CFLAGS:=-idirafter $(BB10_TC_DIR)/include
+	# The NDK's (Dinkum) <math.h> adds C++ overloads (e.g. `pow(float, int)`)
+	# that clash with libstdc++'s <cmath>: disable them.
+	COMPAT_CXXFLAGS:=$(COMPAT_CFLAGS) -D_NO_CPP_INLINES
 else ifeq ($(TARGET), arm-generic)
 	# Defaults to generic crap
 	TARGET_CFLAGS:=$(ARMV6_GENERIC_ARCH)
