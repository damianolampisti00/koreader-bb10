From 4aa96dd8b3cd5335f3cb9e406c3d3beb882ba987 Mon Sep 17 00:00:00 2001
From: Damiano Lampisti <35961105+damianolampisti00@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:02:36 +0100
Subject: [PATCH 2/6] ffi/posix_h: add qnx_arm (BlackBerry 10)

Generated with ffi-cdecl against the BB10 NDK headers (GCC 9.3 cross
compiler); LuaJIT reports QNX as ffi.os == "POSIX".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cmake/CMakeLists.txt          |   3 +
 ffi-cdecl/posix_cdecl.c       |  55 +++-
 ffi-cdecl/posix_h_.lua        |   3 +
 ffi-cdecl/posix_h_qnx_arm.lua | 547 ++++++++++++++++++++++++++++++++++
 ffi/posix_h.lua               | 381 +++++++++++++++++++----
 5 files changed, 920 insertions(+), 69 deletions(-)
 create mode 100644 ffi-cdecl/posix_h_qnx_arm.lua

diff --git a/cmake/CMakeLists.txt b/cmake/CMakeLists.txt
index d820ce3f..a967bcaf 100644
--- a/cmake/CMakeLists.txt
+++ b/cmake/CMakeLists.txt
@@ -787,6 +787,7 @@ set(VERSIONS
     android_arm android_arm64 android_x86 android_x64
     linux_arm linux_arm64 linux_x64
     macos
+    qnx_arm
 )
 add_custom_target(
     posix-ffi
@@ -810,6 +811,8 @@ if(ANDROID)
     set(POSIX_PLATFORM android_${LUAJIT_ARCH})
 elseif(APPLE)
     set(POSIX_PLATFORM macos)
+elseif(BB10)
+    set(POSIX_PLATFORM qnx_${LUAJIT_ARCH})
 else()
     set(POSIX_PLATFORM linux_${LUAJIT_ARCH})
 endif()
diff --git a/ffi-cdecl/posix_cdecl.c b/ffi-cdecl/posix_cdecl.c
