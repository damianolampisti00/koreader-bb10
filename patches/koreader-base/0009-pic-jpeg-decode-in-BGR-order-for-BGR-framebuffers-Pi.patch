From 70b7053c66bfd048b3e955187d2c9ff734d32574 Mon Sep 17 00:00:00 2001
From: Damiano Lampisti <35961105+damianolampisti00@users.noreply.github.com>
Date: Sun, 1 Nov 2026 15:41:50 +0100
Subject: [PATCH 9/9] pic/jpeg: decode in BGR order for BGR framebuffers
 (Pic.bgr)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ffi/jpeg.lua |  9 +++++----
 ffi/pic.lua  | 17 ++++++++++++++---
 2 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/ffi/jpeg.lua b/ffi/jpeg.lua
index 4db4eba2..7fd062f7 100644
--- a/ffi/jpeg.lua
+++ b/ffi/jpeg.lua
@@ -26,16 +26,17 @@ end
 
 local Jpeg = {}
 
-function Jpeg.openDocument(filename, color)
+-- NOTE: bgr: decode color images in BGR order (for devices with a BGR framebuffer, like Mupdf.bgr).
+function Jpeg.openDocument(filename, color, bgr)
     local fh = io.open(filename, "rb")
     assert(fh, "couldn't open JPG file")
     local data = fh:read("*a")
     fh:close()
 
-    return Jpeg.openDocumentFromMem(data, color)
+    return Jpeg.openDocumentFromMem(data, color, nil, bgr)
 end
 
-function Jpeg.openDocumentFromMem(data, color, size)
+function Jpeg.openDocumentFromMem(data, color, size, bgr)
     local handle = tj3Init(turbojpeg.TJINIT_DECOMPRESS)
     assert(handle, "no TurboJPEG API decompressor handle")
 
@@ -57,7 +58,7 @@ function Jpeg.openDocumentFromMem(data, color, size)
     if color then
         image_bb = BB.new(width, height, BB.TYPE_BBRGB24)
         components = 3
-        format = turbojpeg.TJPF_RGB
+        format = bgr and turbojpeg.TJPF_BGR or turbojpeg.TJPF_RGB
     else
         image_bb = BB.new(width, height, BB.TYPE_BB8)
         components = 1
diff --git a/ffi/pic.lua b/ffi/pic.lua
index dd1006fa..3f2ee688 100644
--- a/ffi/pic.lua
+++ b/ffi/pic.lua
@@ -172,7 +172,11 @@ function GifDocument:openPage(number)
         local palette={}
         for c=0, cmap.ColorCount-1 do
             local color = cmap.Colors[c]
-            palette[c] = BB.ColorRGB32(color.Red, color.Green, color.Blue, 0xFF)
+            if Pic.bgr then
+                palette[c] = BB.ColorRGB32(color.Blue, color.Green, color.Red, 0xFF)
+            else
+                palette[c] = BB.ColorRGB32(color.Red, color.Green, color.Blue, 0xFF)
+            end
         end
 
         -- Draw current frame on our bb
@@ -337,6 +341,13 @@ function Pic.openPNGDocument(filename)
         error("unsupported number of color components")
     end
 
+    if Pic.bgr and re.ncomp >= 3 then
+        local p = ffi.cast("uint8_t *", re.data)
+        for i = 0, re.width * re.height * re.ncomp - 1, re.ncomp do
+            p[i], p[i + 2] = p[i + 2], p[i]
+        end
+    end
+
     local doc = PicDocument:new{width=re.width, height=re.height}
     doc.image_bb = BB.new(re.width, re.height, bbtype, re.data)
     doc.components = re.ncomp
@@ -351,7 +362,7 @@ JPG handling
 --]]
 function Pic.openJPGDocument(filename)
     local Jpeg = require("ffi/jpeg")
-    local image, w, h, components = Jpeg.openDocument(filename, Pic.color)
+    local image, w, h, components = Jpeg.openDocument(filename, Pic.color, Pic.bgr)
 
     local doc = PicDocument:new{width=w, height=h}
     doc.image_bb = image
@@ -362,7 +373,7 @@ end
 
 function Pic.openJPGDocumentFromData(data, size)
     local Jpeg = require("ffi/jpeg")
-    local image, w, h, components = Jpeg.openDocumentFromMem(data, Pic.color, size)
+    local image, w, h, components = Jpeg.openDocumentFromMem(data, Pic.color, size, Pic.bgr)
 
     local doc = PicDocument:new{width=w, height=h}
     doc.image_bb = image
-- 
2.56.0

